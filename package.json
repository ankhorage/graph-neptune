{
  "name": "@ankhorage/graph-neptune",
  "version": "0.1.0",
  "type": "module",
  "description": "Amazon Neptune Database Bolt persistence adapter for @ankhorage/graph.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/graph-neptune.git"
  },
  "homepage": "https://github.com/ankhorage/graph-neptune#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/graph-neptune/issues"
  },
  "keywords": [
    "ankhorage",
    "amazon-neptune",
    "bolt",
    "graph",
    "opencypher"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/neptune.d.ts",
      "import": "./dist/neptune.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/graph": "^0.4.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.972.98",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5",
    "neo4j-driver": "^6.3.2"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.9.10",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
